load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load(":defs.bzl", "go_packages_report")

go_library(
    name = "dep",
    srcs = ["dep.go"],
    importpath = "example.com/dep",
)

go_library(
    name = "lib",
    srcs = [
        "lib.go",
        "lib_other.go",
        "lib_unix.go",
    ],
    importpath = "example.com/lib",
    deps = [":dep"],
)

go_binary(
    name = "report",
    srcs = ["report.go"],
    deps = ["@org_golang_x_tools//go/packages"],
)

go_packages_report(
    name = "lib_report",
    dep = ":lib",
)

diff_test(
    name = "lib_report_test",
    file1 = ":lib_report",
    file2 = "lib_report.golden",
)
